# Copy to .env and fill in. Never commit .env.

# From https://api-console.zoho.com (Server-based Application or Self Client)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8765/callback

# Data centre of the Zoho account: com | in | eu | com.au | jp | ca | sa | com.cn
ZOHO_DATA_CENTER=in

# From `zoho-inventory-mcp orgs` after logging in
ZOHO_ORGANIZATION_ID=

# Optional: headless bootstrap with a Self Client refresh token instead of `auth login`
# ZOHO_REFRESH_TOKEN=

# Optional tuning (defaults shown)
# ZOHO_RATE_LIMIT_PER_MINUTE=100
# ZOHO_MAX_CONCURRENCY=5
# ZOHO_DAILY_REQUEST_BUDGET=
# ZOHO_MAX_RETRIES=4
# ZOHO_REDACT_PII=false
# ZOHO_TOKEN_STORE_PATH=~/.config/zoho-inventory-mcp/tokens.json

# --- Local mock instead of real Zoho (see README "Try it in 2 minutes") ---
# ZOHO_CLIENT_ID=mock-client-id
# ZOHO_CLIENT_SECRET=mock-client-secret
# ZOHO_ACCOUNTS_URL=http://127.0.0.1:8800
# ZOHO_REFRESH_TOKEN=mock-refresh-token
# ZOHO_ORGANIZATION_ID=60012345678
